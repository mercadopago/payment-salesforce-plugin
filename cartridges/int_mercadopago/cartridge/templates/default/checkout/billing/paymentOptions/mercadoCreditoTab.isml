<isset name="creditsTitle" value="${Resource.msg('mercadocredito.tab', 'mercadopago', null)}" scope="page" />
<li class="nav-item" data-method-id="${paymentOption.ID}">
    <a class="nav-link checkout-credits-tab" data-toggle="tab" href="#checkout-credits-content" role="tab">
        <img class="checkout-credits-option" src="${URLUtils.staticURL(Resource.msg('mercadocredito.mercadocredito.img', 'mercadopago', null))}" height="32"
            alt="${creditsTitle}" title="${creditsTitle}" />
        <span class="checkout-credits-tab-text">${creditsTitle}</span>
    </a>
</li>
